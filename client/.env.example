# ==============================================================================
# Client / Frontend Environment Configuration
# ==============================================================================

# Backend Service URL (Used by Next.js API rewrites in next.config.mjs)
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Client API Base URL (Leave empty when using Next.js proxy rewrites)
NEXT_PUBLIC_API_URL=

# Google OAuth 2.0 Client ID (Optional for direct frontend Google One-Tap / Identity Services)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
